{
  "name": "awog",
  "version": "0.3.4",
  "private": true,
  "description": "AWOG — Artifact Workflow Orchestrate Guild (local-first AI team OS)",
  "scripts": {
    "dev": "pnpm --filter @awog/desktop dev",
    "electron:dev": "pnpm --filter @awog/desktop dev",
    "dev:ui": "pnpm --filter awog-ui dev",
    "build": "pnpm -r --filter awog-ui --filter @awog/sidecar build",
    "pack": "pnpm --filter @awog/desktop pack",
    "electron:rebuild": "pnpm --filter @awog/desktop rebuild",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix"
  }
}
